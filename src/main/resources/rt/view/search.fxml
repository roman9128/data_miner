<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="457.0" spacing="15" style="             -fx-background-color: #f3f4f6;             -fx-padding: 20;         " xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rt.view.main.MainController">


    <!-- Заголовок -->

    <Label style="                 -fx-font-size: 24px;                 -fx-font-weight: bold;                 -fx-text-fill: #1f2937;             " text="Поиск" />


    <!-- Основная область -->

    <VBox spacing="18" style="                 -fx-background-color: white;                 -fx-background-radius: 10;                 -fx-padding: 20;                 -fx-effect: dropshadow(                     gaussian,                     rgba(0,0,0,0.10),                     10,                     0,                     0,                     2                 );             " VBox.vgrow="ALWAYS">


        <!-- Каналы -->

        <VBox spacing="6">

            <Label style="                         -fx-font-weight: bold;                         -fx-text-fill: #374151;                     " text="Каналы" />

            <ComboBox fx:id="channelsComboBox" maxWidth="Infinity" prefHeight="40" promptText="Выберите каналы" />

        </VBox>


        <!-- Папки -->

        <VBox spacing="6">

            <Label style="                         -fx-font-weight: bold;                         -fx-text-fill: #374151;                     " text="Папки" />

            <ComboBox fx:id="foldersComboBox" maxWidth="Infinity" prefHeight="40" promptText="Выберите папки" />

        </VBox>


        <!-- Период -->

        <VBox spacing="6">

            <Label style="                         -fx-font-weight: bold;                         -fx-text-fill: #374151;                     " text="Период" />

            <HBox spacing="10">

                <DatePicker fx:id="dateFrom" maxWidth="Infinity" promptText="Дата от" HBox.hgrow="ALWAYS" />

                <DatePicker fx:id="dateTo" maxWidth="Infinity" promptText="Дата по" HBox.hgrow="ALWAYS" />

            </HBox>

        </VBox>


        <!-- Уведомления -->

        <VBox spacing="6" VBox.vgrow="SOMETIMES">

            <Label style="                         -fx-font-weight: bold;                         -fx-text-fill: #374151;                     " text="Уведомления" />

            <ListView fx:id="notificationListView" minHeight="120" prefHeight="180" prefWidth="378.0" style="                         -fx-background-color: #f9fafb;                         -fx-border-color: #d1d5db;                         -fx-border-radius: 6;                         -fx-background-radius: 6;                     " VBox.vgrow="SOMETIMES" />

        </VBox>


        <!-- Свободное пространство -->

        <Region VBox.vgrow="ALWAYS" />


        <!-- Кнопки -->


        <HBox alignment="CENTER_LEFT" spacing="10">

            <Label fx:id="queueSizeLabel" style="                 -fx-text-fill: #6b7280;                 -fx-font-size: 13px;                 -fx-font-weight: bold;             " text="Нет сообщений в обработке" />

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#onExportToCSV" style="                 -fx-background-color: #e5e7eb;                 -fx-text-fill: #374151;                 -fx-background-radius: 6;                 -fx-padding: 9 18;             " text="Экспорт в CSV" />

            <Button onAction="#onSearch" style="                 -fx-background-color: #4f46e5;                 -fx-text-fill: white;                 -fx-font-weight: bold;                 -fx-background-radius: 6;                 -fx-padding: 9 22;             " text="Искать" />

        </HBox>

    </VBox>

</VBox>
